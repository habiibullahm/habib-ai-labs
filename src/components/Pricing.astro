---
import { Sparkles } from '@lucide/astro';
import { site } from '../data/site';
import Button from './Button.astro';
import SectionHeading from './SectionHeading.astro';
---
<section class="pricing-section section-pad" id="pricing">
  <div class="section-shell">
    <SectionHeading
      eyebrow="06 — A PLACE TO START"
      title="Start small. Expand when it works"
      note="Focused starting points, scoped to your use case. Every project begins with a conversation about fit."
      row
    />
    <div class="pricing-grid">
      {site.pricing.map((plan) => (
        <article class:list={['price-card', 'reveal', { 'price-featured': plan.featured }]}>
          <div class="price-heading">
            <span class="eyebrow">{plan.tier}</span>
            {plan.featured
              ? <span class="recommended">FOR A BROADER WORKFLOW</span>
              : <Sparkles size={14} class="plan-mark" aria-hidden="true" />}
          </div>
          <h3>{plan.title}</h3>
          <p class="price-description">{plan.description}</p>
          <div class="price-value"><span>{plan.detail}</span><strong>{plan.price}</strong></div>
          <ul class="price-includes">{plan.includes.map((item) => <li>{item}</li>)}</ul>
          <Button href="#contact" label={plan.cta} variant={plan.featured ? 'dark' : 'outline'} />
        </article>
      ))}
    </div>
    <p class="pricing-note">Hosting, model/API usage, and third-party service costs may be charged separately depending on implementation.</p>
  </div>
</section>
